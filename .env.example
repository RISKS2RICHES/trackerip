# Copy to .env.local for local dev
# On Vercel: add via Storage → Postgres → Connect (auto-populates these)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Admin password — set this in Vercel env vars
ADMIN_SECRET=changeme
